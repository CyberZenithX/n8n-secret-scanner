{
  "name": "Risky Workflow",
  "nodes": [
    {
      "name": "HTTP Request",
      "type": "n8n-nodes-base.httpRequest",
      "parameters": {
        "url": "https://api.example.com/data?api_key=sk_test_1234567890ABCDEF1234",
        "headers": {
          "Authorization": "******"
        },
        "allowUnauthorizedCerts": true,
        "apiKey": "rtk_ABCDEFGHIJKLMNOPQRSTUVWXYZ1234",
        "prodWebhook": "https://production.example.com/webhook/customer"
      }
    },
    {
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "parameters": {
        "authentication": "none"
      }
    },
    {
      "name": "Code",
      "type": "n8n-nodes-base.code",
      "parameters": {
        "jsCode": "return eval($json.payload);"
      }
    },
    {
      "name": "Set",
      "type": "n8n-nodes-base.set",
      "parameters": {
        "customerEmail": "person@example.com",
        "customerPhone": "+971 50 123 4567",
        "emiratesId": "784-1987-1234567-1"
      },
      "notes": "Contact at ops@example.com"
    }
  ],
  "settings": {
    "callbackUrl": "http://10.0.0.5/internal/webhook"
  }
}